{
  "name": "signalcraft",
  "private": true,
  "type": "module",
  "description": "Signalcraft Atelier – static terminal + landing. Modular test suite.",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/step1-static.test.mjs tests/step2-unit.test.mjs tests/step6-seo-a11y-security.test.mjs tests/step6-logic.test.mjs tests/step8-a11y-pwa.test.mjs tests/step9-url-a11y.test.mjs tests/step10-ads-inventory.test.mjs tests/step11-ads-logic.test.mjs tests/step15-ads-security.test.mjs tests/step16-seo.test.mjs tests/step18-integrity.test.mjs tests/step20-track-record.test.mjs tests/step22-launch.test.mjs tests/step24-runtime.test.mjs",
    "test:step1": "node --test tests/step1-static.test.mjs",
    "test:step2": "node --test tests/step2-unit.test.mjs",
    "test:step6": "node --test tests/step6-seo-a11y-security.test.mjs tests/step6-logic.test.mjs && node --test --test-concurrency=1 tests/e2e/step6-systematic.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "test:step3": "node --test --test-concurrency=1 tests/e2e/step3-functional.test.mjs",
    "test:step4": "node --test --test-concurrency=1 tests/e2e/step4-beta.test.mjs",
    "test:step5": "node --test --test-concurrency=1 tests/e2e/step5-screenshots.test.mjs",
    "test:step7": "node --test --test-concurrency=1 tests/e2e/step7-extra-shots.test.mjs",
    "test:step8": "node --test tests/step8-a11y-pwa.test.mjs && node --test --test-concurrency=1 tests/e2e/step8-polish.test.mjs",
    "test:step9": "node --test tests/step9-url-a11y.test.mjs && node --test --test-concurrency=1 tests/e2e/step9-url-a11y.test.mjs",
    "test:step10": "node --test tests/step10-ads-inventory.test.mjs",
    "test:step11": "node --test tests/step11-ads-logic.test.mjs",
    "test:step12": "node --test --test-concurrency=1 tests/e2e/step12-ads-containers.test.mjs",
    "test:step13": "node --test --test-concurrency=1 tests/e2e/step13-ads-beta.test.mjs",
    "test:step14": "node --test --test-concurrency=1 tests/e2e/step14-ads-shots.test.mjs",
    "test:step15": "node --test tests/step15-ads-security.test.mjs && node --test --test-concurrency=1 tests/e2e/step15-ads-security.test.mjs",
    "test:step16": "node --test tests/step16-seo.test.mjs",
    "test:step17": "node --test --test-concurrency=1 tests/e2e/step17-seo.test.mjs",
    "test:step18": "node --test tests/step18-integrity.test.mjs",
    "test:step19": "node --test --test-concurrency=1 tests/e2e/step19-integrity.test.mjs",
    "test:step20": "node --test tests/step20-track-record.test.mjs",
    "test:step21": "node --test --test-concurrency=1 tests/e2e/step21-track-record.test.mjs",
    "test:step22": "node --test tests/step22-launch.test.mjs",
    "test:step23": "node --test --test-concurrency=1 tests/e2e/step23-launch.test.mjs",
    "test:step24": "node --test tests/step24-runtime.test.mjs",
    "test:step25": "node --test --test-concurrency=1 tests/e2e/step25-runtime.test.mjs",
    "serve": "python3 -m http.server 4173 --bind 0.0.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@sparticuz/chromium": "^153.0.0",
    "puppeteer-core": "^24.0.0"
  }
}
